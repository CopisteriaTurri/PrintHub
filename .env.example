# Copia in .env e compila. Mai committare .env.

# Obbligatoria in produzione: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DJANGO_DEBUG=False
# Host pubblico dell'hub (es. dietro cloudflared)
DJANGO_ALLOWED_HOSTS=printhub.example.com
CSRF_TRUSTED_ORIGINS=https://printhub.example.com

# Solo LAN su http:// (es. http://192.168.10.190:8010): senza, il login
# all'admin non funziona. Con HTTPS davanti (cloudflared) lascialo commentato.
# PRINTHUB_SECURE_COOKIES=False

# Password del database (usata da docker-compose)
POSTGRES_PASSWORD=

# Facoltative (default tra parentesi)
# PRINTHUB_MAX_FILE_SIZE=52428800        # byte (50 MB)
# PRINTHUB_DEFAULT_EXPIRES_IN=600        # secondi
# PRINTHUB_MAX_EXPIRES_IN=86400          # secondi
# PRINTHUB_FILE_RETENTION_DAYS=7
# PRINTHUB_HEARTBEAT_INTERVAL=20         # secondi
# PRINTHUB_AGENT_OFFLINE_AFTER=60          # secondi; positivo, default 3 heartbeat

# In sviluppo senza docker-compose:
# DATABASE_URL=sqlite:///db.sqlite3     (default)
# PRINTHUB_RESYNC_INTERVAL=5            # secondi tra i controlli dei lavori non consegnati
# PRINTHUB_REOFFER_AFTER=30             # secondi senza job.ack prima di riproporre

# Più processi (WEB_CONCURRENCY > 1) richiedono un channel layer condiviso:
# WEB_CONCURRENCY=1
# CHANNEL_LAYER_URL=redis://printhub-valkey:6379/0   (Valkey o Redis)

# PRINTHUB_JOB_STALLED_AFTER=300  # secondi senza riscontro agente
# PRINTHUB_EVENT_RETENTION_DAYS=90
# PRINTHUB_READINESS_TIMEOUT=3
# PRINTHUB_HOUSEKEEPING_STALE_AFTER=10800
# PRINTHUB_WEBHOOK_ALLOWED_HOSTS=hooks.example.org
# PRINTHUB_WEBHOOK_SECRET_N8N=impostare-un-segreto-casuale
# PRINTHUB_WEBHOOK_MAX_ATTEMPTS=8
# PRINTHUB_WEBHOOK_RETENTION_DAYS=90
